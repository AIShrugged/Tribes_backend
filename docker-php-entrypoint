#!/bin/sh
set -e

command="$1"

ensure_permissions() {
  # storage и cache должны быть writable
  mkdir -p /var/www/storage /var/www/bootstrap/cache || true
  chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache || true
}

graceful_sleep() {
  sleep "${GRACEFUL_SHUTDOWN_SECONDS:-10}"
}

build_sandbox_image_if_enabled() {
  if [ "${BUILD_SANDBOX_IMAGE_ON_START:-0}" != "1" ]; then
    return 0
  fi

  if ! command -v docker >/dev/null 2>&1; then
    echo "docker CLI is unavailable; skipping sandbox image build"
    return 0
  fi

  sandbox_image="${AGENT_TASK_SANDBOX_IMAGE:-spodial-agent-python:latest}"
  sandbox_dockerfile="${AGENT_TASK_SANDBOX_DOCKERFILE:-deploy/sandbox/python/Dockerfile}"
  sandbox_context="${AGENT_TASK_SANDBOX_BUILD_CONTEXT:-deploy/sandbox/python}"

  echo "Building sandbox image ${sandbox_image} from ${sandbox_dockerfile}"
  docker build -t "${sandbox_image}" -f "/var/www/${sandbox_dockerfile}" "/var/www/${sandbox_context}"
}

case "$command" in
  backend)
    ensure_permissions
    php artisan migrate --force --no-interaction
    php artisan scramble:export --path=public/openapi.json --no-interaction || true
    exec php-fpm -R
  ;;

  migration)
    ensure_permissions
    exec php artisan migrate --force --no-interaction
  ;;

  queue-worker)
    ensure_permissions
    build_sandbox_image_if_enabled

    stop_worker() {
      echo "Stopping queue worker..."
      php artisan queue:restart || true
      graceful_sleep
      exit 0
    }

    trap "" SIGPIPE
    trap stop_worker SIGTERM SIGINT SIGHUP

    exec php artisan queue:work \
      --sleep=1 \
      --tries=3 \
      --timeout=90 \
      --no-interaction
  ;;

  schedule)
    ensure_permissions

    stop_scheduler() {
      echo "Stopping scheduler..."
      php artisan schedule:interrupt >/dev/null 2>&1 || true
      graceful_sleep
      exit 0
    }

    trap "" SIGPIPE
    trap stop_scheduler SIGTERM SIGINT SIGHUP

    # Рекомендованный вариант для контейнера (Laravel 9+)
    exec php artisan schedule:work --no-interaction
  ;;

  nginx)
    ln -sf /dev/stdout /var/log/nginx/access.log || true
    ln -sf /dev/stderr /var/log/nginx/error.log || true
    exec nginx -g "daemon off;"
  ;;

  *)
    exec "$@"
  ;;
esac
